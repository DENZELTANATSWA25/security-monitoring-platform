# Application
APP_NAME=Security Monitoring Platform
APP_ENV=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/security_db

# Redis
REDIS_URL=redis://redis:6379/0

# Authentication
# Generate a unique secret for real deployments. Never commit the real value.
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Browser access
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Login rate limiting
LOGIN_RATE_LIMIT_PER_EMAIL=10
LOGIN_RATE_LIMIT_PER_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# GeoIP
GEOIP_DATABASE_PATH=/data/geoip/GeoLite2-City.mmdb
TRUSTED_PROXY_IPS=

# External telemetry ingestion
INGESTION_API_KEY_HEADER=X-Ingestion-Key
INGESTION_RATE_LIMIT=100
INGESTION_RATE_WINDOW_SECONDS=60

# Telemetry monitoring
TELEMETRY_SOURCE_ONLINE_THRESHOLD_SECONDS=300

# ML anomaly detection
ANOMALY_MODEL_DIRECTORY=models/anomaly_detection